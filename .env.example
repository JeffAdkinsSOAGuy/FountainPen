# Copy this file to ".env" (same folder) and put your key after the equals sign.
# Then run: npm run build
#
# .env is listed in .gitignore, so it is never committed or pushed.
# The key is also built into dist/fountainpen.html on your computer, so do not send that file to anyone.

ANTHROPIC_API_KEY=

# Optional: the model Find beats uses by default.
# FOUNTAINPEN_MODEL=claude-sonnet-5-5
